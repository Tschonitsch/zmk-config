#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/mouse.h>

/* ---------------------------------
 * RGB LED Configuration
 * --------------------------------- */

&led_strip {
    // chain-length = <6>;
    chain-length = <35>; // Both per-key and underglow LEDs
    // chain-length = <29>; // Only per-key LEDs
};

/ {
    keymap {
        compatible = "zmk,keymap";

        // ---------- Base Layer ----------
        /*
        * ,-----------------------------------------.                    ,-----------------------------------------.
        * |  ESC |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |   0  | Bspc |
        * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        * | TAB  |   Q  |   W  |   E  |   R  |   T  |                    |   Z  |   U  |   I  |   O  |   P  |  Ü   |
        * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        * |LShift|   A  |   S  |   D  |   F  |   G  |-------.    ,-------|   H  |   J  |   K  |   L  |   Ö  |  Ä   |
        * |------+------+------+------+------+------| Scroll|    | Volume|------+------+------+------+------+------|
        * | LCTL |   Y  |   X  |   C  |   V  |   B  |-------|    |-------|   N  |   M  |   ,  |   .  |   -  |   +  |
        * `-----------------------------------------/       /     \      \-----------------------------------------'
        *            | _GAME| LALT | <|>  | LGUI | /Space  /       \Enter \  | RALT | _FUNC|      |  #'’ |
        *            |      |      |      |      |/       /         \      \ |      |      |      |      |
        *            `----------------------------------'           '------''---------------------------'
        */
        default_layer {
            bindings = <
                &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5
                &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC

                &kp TAB &kp Q &kp W &kp E &kp R &kp T 
                &kp Z &kp U &kp I &kp O &kp P &kp LBKT

                &kp LSHFT &kp A &kp S &kp D &kp F &kp G 
                &kp H &kp J &kp K &kp L &kp SEMI &kp SQT

                &kp LCTRL &kp Y &kp X &kp C &kp V &kp B
                &kp N &kp M &kp COMMA &kp DOT &kp MINUS &kp PLUS

                &mo 1 &kp LALT &kp NUBS &kp HOME &kp SPACE
                &kp RET &kp RALT &mo 2 &trans &kp HASH
            >;

            sensor-bindings = <
                // Left Encoder: Scroll
                &inc_dec_kp PG_UP PG_DN

                // Right Encoder: Volume
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };
        // ---------- Base Layer ----------

        // ---------- Game Layer ----------
        /*
        * ,-----------------------------------------.                    ,-----------------------------------------.
        * |  ESC |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |   0  | Bspc |
        * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        * |  F3  | TAB  |   Q  |   W  |   E  |   R  |                    |   Z  |   U  |   I  |   O  |   P  |  Ü   |
        * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        * |  F2  |LShift|   A  |   S  |   D  |   F  |-------.    ,-------|   H  |   J  |   K  |   L  |   Ö  |  Ä   |
        * |------+------+------+------+------+------| Scroll|    | Volume|------+------+------+------+------+------|
        * |  F1  | LCTL |   Y  |   X  |   C  |   V  |-------|    |-------|   N  |   M  |   ,  |   .  |   -  |RShift|
        * `-----------------------------------------/       /     \      \-----------------------------------------'
        *            | _GAME| LGUI |      | LAlt | /Space  /       \Enter \  | RALT | RCTL | RGUI |      |
        *            |      |      |      |      |/       /         \      \ |      |      |      |      |
        *            `----------------------------------'           '------''---------------------------'
        */
        game_layer {
            bindings = <
                &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5              &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC
                &kp F3 &kp TAB &kp Q &kp W &kp E &kp R                  &kp Z &kp U &kp I &kp O &kp P &kp LBKT
                &kp F2 &kp LSHFT &kp A &kp S &kp D &kp F                &kp H &kp J &kp K &kp L &kp SEMI &kp SQT
                &kp F1 &kp LCTRL &kp Y &kp X &kp C &kp V                &kp N &kp M &kp COMMA &kp DOT &kp SLASH &kp RSHFT
                &tog 1 &kp LGUI &trans &kp LALT &kp SPACE               &kp RET &kp RALT &kp RCTRL &kp RGUI &trans
            >;

            sensor-bindings = <
                // Left Encoder: Scroll
                &inc_dec_kp PG_UP PG_DN

                // Right Encoder: Volume
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };
        // ---------- Game Layer ----------

        // ---------- Function Layer ----------
        /*
        * ,-----------------------------------------.                    ,-----------------------------------------.
        * |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  |                    |  F7  |  F8  |  F9  |  F10 |  F11 | F12  |
        * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        * | TAB  |   Q  |   W  |   E  |   R  |   T  |                    |      |      |   ↑  |      |   (  |  )   |
        * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        * |LShift|   A  |   S  |   D  |   F  |   G  |-------.    ,-------| #'’  |   ←  |   ↑  |   →  |   {  |  }   |
        * |------+------+------+------+------+------| MS x-A|    |MS y-A |------+------+------+------+------+------|
        * | LCTL |   Y  |   X  |   C  |   V  |   B  |-------|    |-------|      |      |   ,  |   .  |   [  |  ]   |
        * `-----------------------------------------/       /    \       \-----------------------------------------'
        *            |      | LGUI |      | LALT | /L-Click/      \R-CLick\  | RALT | _FUNC| RGUI | RGUI |
        *            |      |      |      |      |/       /        \       \ |      |      |      |      |
        *            `----------------------------------'           '------''---------------------------'
        */
        func_layer {
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6               &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &kp TAB &kp Q &kp W &kp E &kp R &kp T                   &trans &trans &kp UP &trans &kp LPAR &kp RPAR
                &kp LSHFT &kp A &kp S &kp D &kp F &kp G                 &kp HASH &kp LEFT &kp DOWN &kp RIGHT &kp LBRC &kp RBRC
                &kp LCTRL &kp Y &kp X &kp C &kp V &kp B                 &trans &trans &trans &trans &kp COMMA &kp DOT &kp LBKT &kp RBKT
                &trans &kp LGUI &trans &kp LALT &mkp LCLK               &mkp RCLK &kp RALT &tog 2 &kp RGUI &kp RCTRL
            >;

            sensor-bindings = <
                // Left Encoder: Mouse X
                &inc_dec_kp C_VOL_UP C_VOL_DN

                // Right Encoder: Mouse Y
                &inc_dec_kp PG_UP PG_DN
            >;
        };
        // ---------- Function Layer ----------
    };
};
