#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/socd.dtsi>

// ---------- Led ----------
&led_strip {
    // chain-length = <6>; // Only underglow LEDs
    chain-length = <35>; // Both per-key and underglow LEDs
    // chain-length = <29>; // Only per-key LEDs
};
// ---------- Led ----------

// ---------- Keymap ----------
/ {
    behaviors {
        socd2: socd2 {
            compatible = "zmk,behavior-socd";
            #binding-cells = <1>;
            bindings = <&kp>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        // ---------- Base Layer ----------
        /*
        * ,-----------------------------------------.                    ,-----------------------------------------.
        * |  ESC |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |   0  | Bspc |
        * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        * | TAB  |   Q  |   W  |   E  |   R  |   T  |                    |   Z  |   U  |   I  |   O  |   P  |  Ü   |
        * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        * |LShift|   A  |   S  |   D  |   F  |   G  |-------.    ,-------|   H  |   J  |   K  |   L  |   Ö  |  Ä   |
        * |------+------+------+------+------+------| Scroll|    | Volume|------+------+------+------+------+------|
        * | LCTL |   Y  |   X  |   C  |   V  |   B  |-------|    |-------|   N  |   M  |   ,  |   .  |   -  |   +  |
        * `-----------------------------------------/       /     \      \-----------------------------------------'
        *            | _GAME| LALT | <|>  | LGUI | /Space  /       \Enter \  | RALT | _FUNC|      |  #'’ |
        *            |      |      |      |      |/       /         \      \ |      |      |      |      |
        *            `----------------------------------'           '------''---------------------------' */

        default_layer {
            bindings = <
                &kp ESC    &kp N1  &kp N2  &kp N3        &kp N4                &kp N5                             &kp N6         &kp N7  &kp N8     &kp N9           &kp N0     &kp BSPC
                &kp TAB    &kp Q   &kp W   &kp E         &kp R                 &kp T                              &kp Y          &kp U   &kp I      &kp O            &kp P      &kp LBKT
                &kp LSHFT  &kp A   &kp S   &kp D         &kp F                 &kp G                              &kp H          &kp J   &kp K      &kp L            &kp SEMI   &kp SQT
                &kp LCTRL  &kp Z   &kp X   &kp C         &kp V                 &kp B     &none                    &none       &kp N          &kp M   &kp COMMA  &kp PERIOD       &kp SLASH  &kp RIGHT_BRACKET
                                   &tog 1  &kp LEFT_ALT  &kp NON_US_BACKSLASH  &kp LWIN  &kp SPACE    &kp RETURN  &kp RIGHT_ALT  &tog 2  &none      &kp NON_US_HASH
            >;

            sensor-bindings = <
                &msc SCRL_UP &msc SCRL_DOWN
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };
        // ---------- Base Layer ----------

        // ---------- Game Layer ----------
        /*
        * ,-----------------------------------------.                    ,-----------------------------------------.
        * |  ESC |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |   0  | Bspc |
        * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        * |  F3  | TAB  |   Q  |   W  |   E  |   R  |                    |   Z  |   U  |   I  |   O  |   P  |  Ü   |
        * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        * |  F2  |LShift|   A  |   S  |   D  |   F  |-------.    ,-------|   H  |   J  |   K  |   L  |   Ö  |  Ä   |
        * |------+------+------+------+------+------| Scroll|    | Volume|------+------+------+------+------+------|
        * |  F1  | LCTL |   Y  |   X  |   C  |   V  |-------|    |-------|   N  |   M  |   ,  |   .  |   -  |RShift|
        * `-----------------------------------------/       /     \      \-----------------------------------------'
        *            | _GAME|      | LGUI | LAlt | /Space  /       \Enter \  | RALT | RCTL | RGUI |      |
        *            |      |      |      |      |/       /         \      \ |      |      |      |      |
        *            `----------------------------------'           '------''---------------------------'
        */

        game_layer {
            bindings = <
                &kp ESC  &kp N1          &kp N2   &kp N3    &kp N4    &kp N5                                 &kp N6         &kp N7     &kp N8         &kp N9      &kp N0     &kp BSPC
                &kp TAB  &kp TAB         &kp Q    &socd2 W  &kp E     &kp R                                  &kp Y          &kp U      &kp I          &kp O       &kp P      &kp LBKT
                &kp F2   &kp LEFT_SHIFT  &socd A  &socd2 S  &socd D   &kp F                                  &kp H          &kp J      &kp K          &kp L       &kp SEMI   &kp SQT
                &kp F1   &kp LCTRL       &kp Z    &kp X     &kp C     &kp V         &none        &none       &kp N          &kp M      &kp COMMA      &kp PERIOD  &kp SLASH  &kp RIGHT_BRACKET
                                         &tog 1   &none     &kp LWIN  &kp LEFT_ALT  &kp SPACE    &kp RETURN  &kp RIGHT_ALT  &kp RCTRL  &kp RIGHT_WIN  &none
            >;

            sensor-bindings = <
                &msc SCRL_UP &msc SCRL_DOWN
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };
        // ---------- Game Layer ----------

        // ---------- Function Layer ----------
        /*
        * ,-----------------------------------------.                    ,-----------------------------------------.
        * |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  |                    |  F7  |  F8  |  F9  |  F10 |  F11 | F12  |
        * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        * | TAB  |      |      |      |      |      |                    |      |      |   ↑  |      |   (  |  )   |
        * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        * |LShift|      |      |      |      |      |-------.    ,-------|      |   ←  |   ↑  |   →  |   {  |  }   |
        * |------+------+------+------+------+------| MS x-A|    |MS y-A |------+------+------+------+------+------|
        * | LCTL |      |      |      |      |      |-------|    |-------|      |      |   ,  |   .  |   [  |  ]   |
        * `-----------------------------------------/       /    \       \-----------------------------------------'
        *            | HUD  | HUI  | EFF  | TOG  | /L-Click/      \R-CLick\  | RALT | _FUNC|      | #'’  |
        *            |      |      |      |      |/       /        \       \ |      |      |      |      |
        *            `----------------------------------'           '------''---------------------------'
        */

        func_layer {
            bindings = <
                &kp F1     &kp F2  &kp F3           &kp F4           &kp F5           &kp F6                                               &kp F7         &kp F8    &kp F9     &kp F10          &kp F11           &kp F12
                &kp TAB    &none   &none            &none            &none            &none                                                &none          &none     &kp UP     &none            &kp LPAR          &kp RPAR
                &kp LSHFT  &none   &none            &none            &none            &none                                                &none          &kp LEFT  &kp DOWN   &kp RIGHT        &kp LBRC          &kp RBRC
                &kp LCTRL  &none   &msc SCRL_DOWN   &none            &none            &none            &rgb_ug RGB_HUD    &rgb_ug RGB_HUI  &none          &none     &kp COMMA  &kp PERIOD       &kp LEFT_BRACKET  &kp RIGHT_BRACKET
                                   &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_EFF  &rgb_ug RGB_TOG  &mkp MB1           &mkp MB2         &kp RIGHT_ALT  &tog 2    &none      &kp NON_US_HASH
            >;

            sensor-bindings = <
                &msc SCRL_UP &msc SCRL_DOWN
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };
        // ---------- Function Layer ----------
    };
};
// ---------- Keymap ----------
